{
  "manifest_version": 3,
  "name": "ATOM",
  "short_name": "ATOM",
  "version": "0.4.0",
  "description": "A private browsing agent in your sidebar. Ask anything, read the page you're on, and let it work across your tabs when you say so.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ATOM",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "sandbox": {
    "pages": ["newtab/wall-frame.html"]
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "cookies",
    "history",
    "bookmarks",
    "downloads",
    "webNavigation",
    "tabGroups",
    "sidePanel",
    "clipboardRead",
    "clipboardWrite",
    "notifications",
    "alarms",
    "contextMenus",
    "search",
    "offscreen",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "open-atom": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open ATOM in the side panel"
    },
    "stop-agent": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Stop whatever ATOM is doing"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
